{
  "name": "herdr-conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check:shell": "bash -n scripts/*.sh",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm test && npm run check:shell && npm run check:manifest && npm run check:docs"
  }
}
