{
  "name": "herdr-conductor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check:shell": "bash -n scripts/*.sh",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:evidence": "node scripts/check-evidence-inventory.mjs && node scripts/check-b0-identity-evidence.mjs && node scripts/check-stage1-live-smoke-evidence.mjs",
    "smoke:stage1:live": "node scripts/run-stage1-live-smoke.mjs",
    "check": "npm test && npm run check:shell && npm run check:manifest && npm run check:docs && npm run check:evidence"
  }
}
